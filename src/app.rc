/* DriveMonitor - icon, manifest, VERSIONINFO. MIT: see LICENSE. */

#include <windows.h>
#include "resource.h"

IDI_APPICON  ICON  "app.ico"

/* Embed the application manifest (Common-Controls v6 + requireAdministrator). */
1 24 "app.manifest"

/* ----------------------------------------------------------------------------
 *  Version information block.
 *
 *  Windows Explorer's "Details" tab reads these values from the .exe.
 *  All fields are kept in sync with the author / sponsor metadata used
 *  elsewhere in the project.
 * ---------------------------------------------------------------------------- */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    DRIVEMONITOR_FILEVERSION
 PRODUCTVERSION DRIVEMONITOR_FILEVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "chuikoff"
            VALUE "FileDescription",  "DriveMonitor " DRIVEMONITOR_VERSION " (сборка " DRIVEMONITOR_BUILD_STR ")"
            VALUE "FileVersion",      DRIVEMONITOR_FILEVERSION_STR
            VALUE "InternalName",     "DriveMonitor"
            VALUE "LegalCopyright",   "Copyright (c) 2026 chuikoff. MIT License."
            VALUE "OriginalFilename", "DriveMonitor.exe"
            VALUE "ProductName",      "DriveMonitor"
            VALUE "ProductVersion",   DRIVEMONITOR_VERSION
            VALUE "Comments",         "100% Free Open Source Software. Author: chuikoff. Support: https://boosty.to/chuikoff"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
